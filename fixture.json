{
    "model": "content.values",
    "pk": 1,
    "fields": {
        "name": "Домашнее тепло",
        "description": "Мы создаём атмосферу, в которой каждый чувствует себя желанным гостем, а не просто номером заказа."
    }
},
{
    "model": "content.values",
    "pk": 2,
    "fields": {
        "name": "Искренность во всём",
        "description": "Честные цены, настоящие продукты, открытая кухня, где видно процесс приготовления, и никакого пафоса. Мы такие, какие есть — тёплые и настоящие."
    }
},
{
    "model": "content.values",
    "pk": 3,
    "fields": {
        "name": "Внимание к деталям",
        "description": "Свежие цветы на каждом столике, правильная температура подачи блюд, мягкий свет, удобные стулья, быстрый Wi-Fi — мы продумываем всё, чтобы гость ни о чём не беспокоился."
    }
},
{
    "model": "content.values",
    "pk": 4,
    "fields": {
        "name": "Единство с природой",
        "description": "На террасе мы создаём зелёный уголок, используем сезонные продукты от местных фермеров и заботимся об экологии: сортируем отходы, минимизируем пластик."
    }
},
{
    "model": "content.values",
    "pk": 5,
    "fields": {
        "name": "Команда — одна семья",
        "description": "Наши сотрудники не просто работают — они живут рестораном. Мы учимся, растем и поддерживаем друг друга. Счастливый персонал = счастливые гости."
    }
},
{
    "model": "content.aboutpage",
    "pk": 2,
    "fields": {
        "history": "Всё началось с семейных обедов на маленькой кухне. Сегодня «Тёплый вечер» — это уютный зал с панорамными окнами и зелёная терраса, где можно спрятаться от городской суеты. Мы объединяем семейные традиции и современную кухню, чтобы каждый ваш вечер стал особенным.",
        "mission": "Создавать тёплые воспоминания за каждым столом.",
        "values": [
            1,
            2,
            3,
            4,
            5
        ]
    }
},
{
    "model": "content.staff",
    "pk": 1,
    "fields": {
        "name": "Алексей",
        "role": "шеф-повар и основатель ресторана",
        "description": "«Для меня идеальный гость — тот, кто уходит сытым не только телом, но и душой».",
        "photo": "team/shef.png"
    }
},
{
    "model": "content.staff",
    "pk": 2,
    "fields": {
        "name": "Елена",
        "role": "администратор",
        "description": "«Я люблю свою работу за то, что каждый день — живой. Сегодня романтический ужин, завтра — шумная компания друзей, послезавтра — деловые переговоры. И ко всем нужен свой ключик».",
        "photo": "team/admin.png"
    }
},
{
    "model": "content.staff",
    "pk": 3,
    "fields": {
        "name": "Дмитрий",
        "role": "официант",
        "description": "Гости ценят его за лёгкость, искренний юмор и умение быть ненавязчиво внимательным. Он не будет отвлекать, если вы хотите побыть вдвоём, но вовремя заметит пустой бокал или вопрос в глазах.",
        "photo": "team/oficiant.png"
    }
},
{
    "model": "content.staff",
    "pk": 4,
    "fields": {
        "name": "Ирина",
        "role": "шеф-кондитер",
        "description": "«Сладкое — это маленький праздник. Я люблю придумывать новые десерты, экспериментировать со вкусами, но всегда оставляю в них что-то очень родное, понятное, тёплое».",
        "photo": "team/conditer.png"
    }
},
{
    "model": "content.staff",
    "pk": 5,
    "fields": {
        "name": "Артем",
        "role": "бармен",
        "description": "«Бар — это место, где начинаются и заканчиваются вечера. Я люблю наблюдать, как после первого глотка у гостя меняется настроение, как расслабляются плечи, появляется улыбка. Это и есть моё главное удовольствие».",
        "photo": "team/barmen.png"
    }
}
]
